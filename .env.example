# основная модель: Gemma 4 26B-A4B (scripts/serve_llm.sh), офлайн-запасная: T-lite 2.1 8B
LLM_BASE_URL=http://localhost:8080/v1
LLM_MODEL=gemma4-26b
EMBED_MODEL=BAAI/bge-m3
LLM_API_KEY=
LLM_THINKING=false  # true - рассуждения везде, answer - только на шаге ответа (для плотных моделей)
LLM_TEMPERATURE=0.1
# запасная модель: LLM_MODEL=tlite-2.1
# MCP_URL=http://127.0.0.1:8765/mcp   (если не задан, сервер инструментов запускается как подпроцесс)
# SEARXNG_URL=http://localhost:8888   (свой SearXNG; без него поиск идёт через DuckDuckGo)
# WEB_ENABLED=false   (офлайн: шаг web пропускается, агент отказывает как раньше)
# FAITH_CHECK=false   (выключить проверку утверждений по тексту источников, по умолчанию включена)
# RERANK=false   (без реранкера bge-reranker-v2-m3: быстрее, но recall ниже)
